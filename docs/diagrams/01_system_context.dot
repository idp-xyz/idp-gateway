digraph G { graph [fontname="Noto Sans CJK SC",bgcolor="#ffffff",pad="0.3",nodesep="0.45",ranksep="0.65",splines="ortho",labelloc=t,labeljust=l,fontsize=21,fontcolor="#12233b"];node [shape=box,style="rounded,filled",color="#DCE5EF",fillcolor="#F4F7FB",fontname="Noto Sans CJK SC",fontcolor="#203249",fontsize=12,penwidth=1.2,margin="0.24,0.16"];edge [color="#93A9BE",penwidth=1.7,arrowsize=.7,fontname="Noto Sans CJK SC",fontsize=9,fontcolor="#52708B"];
