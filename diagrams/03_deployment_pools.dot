subgraph cluster_egress {label="内网出站域";color="#7BC1B4";style="rounded";lbe[label="Private LB / DNS"];ge1[label="Egress Gateway A",fillcolor="#E3F5F1"];ge2[label="Egress Gateway B",fillcolor="#E3F5F1"];lbe->ge1;lbe->ge2;}
