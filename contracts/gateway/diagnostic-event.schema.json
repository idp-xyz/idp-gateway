{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IDP Diagnostic Stage Evidence V1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "trace_id",
    "route_id",
    "config_digest",
    "tenant_ref",
    "request_id",
    "stages",
    "failure_origin",
    "business_outcome",
    "observed_at"
  ],
  "properties": {
    "trace_id": {
      "type": "string",
      "minLength": 4
    },
    "route_id": {
      "type": "string",
      "minLength": 4
    },
    "config_digest": {
      "type": "string",
      "minLength": 4
    },
    "tenant_ref": {
      "type": "string",
      "minLength": 4
    },
    "request_id": {
      "type": "string",
      "minLength": 4
    },
    "observed_at": {
      "type": "string",
      "format": "date-time"
    },
    "failure_origin": {
      "enum": [
        "GATEWAY_AUTHN",
        "GATEKEEPER_AUTHZ",
        "GATEWAY_RATE_LIMIT",
        "UPSTREAM_PROVIDER",
        "NETWORK",
        "UNKNOWN",
        "NONE"
      ]
    },
    "business_outcome": {
      "enum": [
        "SUCCESS",
        "DEFINITE_FAILURE",
        "UNKNOWN",
        "NOT_SENT"
      ]
    },
    "stages": {
      "type": "array",
      "minItems": 1,
      "maxItems": 4,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "stage",
          "status",
          "timestamp"
        ],
        "properties": {
          "stage": {
            "enum": [
              "INGRESS",
              "EGRESS",
              "UPSTREAM_RESPONSE",
              "DOWNSTREAM_RESPONSE"
            ]
          },
          "status": {
            "enum": [
              "CAPTURED_SANITIZED",
              "METADATA_ONLY",
              "NOT_SENT",
              "NOT_OBSERVED",
              "TRUNCATED",
              "NOT_CAPTURED"
            ]
          },
          "timestamp": {
            "type": "string",
            "format": "date-time"
          },
          "http_status": {
            "type": "integer",
            "minimum": 100,
            "maximum": 599
          },
          "sanitized_headers": {
            "type": "object",
            "description": "Allowlist, not a blocklist: a header that is not named in $defs.sanitized_header_name is not evidence. Names are recorded in lowercase.",
            "propertyNames": {
              "$ref": "#/$defs/sanitized_header_name"
            },
            "additionalProperties": {
              "$ref": "#/$defs/sanitized_header_value"
            }
          },
          "body_sha256": {
            "type": "string",
            "pattern": "^[a-f0-9]{64}$"
          },
          "body_sample_sanitized": {
            "type": "string",
            "maxLength": 65536
          },
          "bytes_observed": {
            "type": "integer",
            "minimum": 0
          },
          "message_kind": {
            "enum": [
              "REQUEST",
              "RESPONSE"
            ]
          },
          "hop": {
            "enum": [
              "CLIENT_GATEWAY",
              "GATEWAY_UPSTREAM"
            ]
          },
          "http_method": {
            "type": "string",
            "enum": [
              "GET",
              "POST",
              "PUT",
              "PATCH",
              "DELETE",
              "HEAD",
              "OPTIONS",
              "CONNECT",
              "TRACE"
            ]
          },
          "request_target": {
            "type": "string",
            "maxLength": 4096
          },
          "http_version": {
            "type": "string",
            "maxLength": 12
          },
          "content_type": {
            "type": "string",
            "maxLength": 128
          },
          "body_capture_status": {
            "enum": [
              "DISABLED",
              "METADATA_ONLY",
              "CAPTURED_SANITIZED",
              "EMPTY",
              "TRUNCATED",
              "NOT_CAPTURED",
              "NOT_OBSERVED"
            ]
          },
          "body_total_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "body_captured_bytes": {
            "type": "integer",
            "minimum": 0
          },
          "truncated": {
            "type": "boolean"
          },
          "redaction_policy_ref": {
            "type": "string",
            "maxLength": 128
          },
          "provider_request_id_sanitized": {
            "type": "string",
            "maxLength": 128
          },
          "grpc_status": {
            "type": "integer",
            "minimum": 0,
            "maximum": 16
          }
        },
        "if": {
          "required": [
            "status"
          ],
          "properties": {
            "status": {
              "enum": [
                "NOT_SENT",
                "NOT_OBSERVED"
              ]
            }
          }
        },
        "then": {
          "description": "A message that was not sent or not observed has no status code, headers or body to report.",
          "not": {
            "anyOf": [
              {
                "required": [
                  "http_status"
                ]
              },
              {
                "required": [
                  "grpc_status"
                ]
              },
              {
                "required": [
                  "sanitized_headers"
                ]
              },
              {
                "required": [
                  "body_sha256"
                ]
              },
              {
                "required": [
                  "body_sample_sanitized"
                ]
              },
              {
                "required": [
                  "bytes_observed"
                ]
              },
              {
                "required": [
                  "body_total_bytes"
                ]
              },
              {
                "required": [
                  "body_captured_bytes"
                ]
              },
              {
                "required": [
                  "content_type"
                ]
              },
              {
                "required": [
                  "provider_request_id_sanitized"
                ]
              }
            ]
          }
        }
      }
    }
  },
  "$defs": {
    "sanitized_header_name": {
      "description": "Same set as ALLOWED_HEADERS in scripts/diagnostic_reference.py; tests/contracts/test_bypass_regressions.py keeps them equal.",
      "enum": [
        "content-type",
        "traceparent",
        "x-correlation-id",
        "x-provider-request-id",
        "x-request-id"
      ]
    },
    "sanitized_header_value": {
      "description": "Printable ASCII, under 256 characters, and not shaped like a credential. A heuristic backstop: redaction happens before the event is built, not here.",
      "type": "string",
      "maxLength": 255,
      "not": {
        "anyOf": [
          {
            "pattern": "[^\\u0020-\\u007e]"
          },
          {
            "pattern": "^(?:[Bb][Ee][Aa][Rr][Ee][Rr]|[Bb][Aa][Ss][Ii][Cc]|[Dd][Ii][Gg][Ee][Ss][Tt]|[Nn][Ee][Gg][Oo][Tt][Ii][Aa][Tt][Ee])\\s"
          },
          {
            "pattern": "eyJ[A-Za-z0-9_-]{8,}\\.eyJ"
          }
        ]
      }
    }
  }
}
