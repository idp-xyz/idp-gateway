{
  "traffic_class": "AI",
  "pool": {
    "name": "ai-test",
    "environment": "TEST",
    "public_hostname": "ai.example",
    "path_prefix": "/llm",
    "listen_port": 8091,
    "bind_address": "127.0.0.1",
    "admin_addr": "127.0.0.1:15100",
    "stats_addr": "127.0.0.1:15120",
    "readiness_addr": "127.0.0.1:15121",
    "readback_port": 8444,
    "publisher_identity": "spiffe://idp.test/gateway-control/publisher",
    "tls_dir": "tls",
    "jwt_issuer": "https://issuer.example/ai",
    "jwt_audiences": ["example-ai"],
    "jwks_file": "tls/jwks.json",
