{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.idp.internal/gateway/ai-compile-spec-1.0.json",
  "title": "AI compile spec",
  "description": "Input to AI compile. One document is one pool and one intent. intent.ai_protocol selects LLM, MCP, or A2A. A field that belongs to another branch is invalid. The listener, JWT, and upstream address are fields of this document. The compiler does not embed a product hostname, an API key, or an MCP or A2A credential.",
  "type": "object",
  "additionalProperties": false,
  "required": ["traffic_class", "pool", "intent"],
  "properties": {
    "traffic_class": { "const": "AI" },
    "pool": { "$ref": "#/$defs/pool" },
    "intent": { "$ref": "#/$defs/intent" },
    "provider": { "$ref": "#/$defs/provider" },
    "models": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/model" }
    },
    "mcp": { "$ref": "#/$defs/mcp" },
    "a2a": { "$ref": "#/$defs/a2a" }
  },
  "allOf": [
    {
      "if": {
        "type": "object",
        "required": ["intent"],
        "properties": {
          "intent": {
            "type": "object",
            "required": ["ai_protocol"],
            "properties": { "ai_protocol": { "const": "LLM" } }
          }
        }
      },
      "then": {
        "required": ["provider", "models"],
        "allOf": [
          { "not": { "required": ["mcp"] } },
          { "not": { "required": ["a2a"] } }
        ]
      }
    },
    {
      "if": {
        "type": "object",
        "required": ["intent"],
        "properties": {
          "intent": {
            "type": "object",
            "required": ["ai_protocol"],
            "properties": { "ai_protocol": { "const": "MCP" } }
          }
        }
      },
      "then": {
        "required": ["mcp"],
        "allOf": [
          { "not": { "required": ["provider"] } },
          { "not": { "required": ["models"] } },
          { "not": { "required": ["a2a"] } }
        ]
      }
    },
    {
      "if": {
        "type": "object",
        "required": ["intent"],
        "properties": {
          "intent": {
            "type": "object",
            "required": ["ai_protocol"],
            "properties": { "ai_protocol": { "const": "A2A" } }
          }
        }
      },
      "then": {
        "required": ["a2a"],
        "allOf": [
          { "not": { "required": ["provider"] } },
          { "not": { "required": ["models"] } },
          { "not": { "required": ["mcp"] } }
        ]
      }
    }
  ],
  "$defs": {
    "pool": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "name", "environment", "public_hostname", "path_prefix", "listen_port",
        "bind_address", "admin_addr", "stats_addr", "readiness_addr", "readback_port",
        "publisher_identity", "tls_dir", "jwt_issuer", "jwt_audiences", "jwks_file"
      ],
      "properties": {
        "name": { "type": "string", "pattern": "^ai-(dev|test|prod)(?:-[a-z0-9]+)*$" },
        "environment": { "type": "string", "enum": ["DEV", "TEST", "PROD"] },
        "public_hostname": { "type": "string", "pattern": "^(?:[a-z0-9-]+\\.)+[a-z]{2,}$" },
        "path_prefix": { "type": "string", "pattern": "^(/[A-Za-z0-9_~-][A-Za-z0-9._~-]*)+$" },
        "listen_port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "bind_address": { "type": "string", "minLength": 1 },
        "admin_addr": { "type": "string", "minLength": 1 },
        "stats_addr": { "type": "string", "minLength": 1 },
        "readiness_addr": { "type": "string", "minLength": 1 },
        "readback_port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "publisher_identity": { "type": "string", "minLength": 1 },
        "tls_dir": { "type": "string", "minLength": 1 },
        "jwt_issuer": { "type": "string", "format": "uri" },
        "jwt_audiences": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "jwks_file": { "type": "string", "minLength": 1 },
        "notes": { "type": "string" },
        "tracing": { "$ref": "#/$defs/tracing" }
      }
    },
    "tracing": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "service_name"],
      "properties": {
        "host": { "type": "string", "pattern": "^[a-z0-9][a-z0-9._-]*:[1-9][0-9]*$" },
        "protocol": { "type": "string", "enum": ["http", "grpc"] },
        "path": { "type": "string", "pattern": "^/[^\\s?#]*$" },
        "service_name": { "type": "string", "pattern": "^[a-z][a-z0-9._-]{1,63}$" },
        "random_sampling": { "type": "number", "minimum": 0, "maximum": 1 },
        "client_sampling": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "intent": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intent_id", "ai_protocol", "ai_target_ref", "authz_profile",
        "approval_ref", "expected_generation", "policy_bundle_ref"
      ],
      "properties": {
        "intent_id": { "type": "string", "pattern": "^gwi-[a-z0-9-]{3,64}$" },
        "ai_protocol": { "type": "string", "enum": ["LLM", "MCP", "A2A"] },
        "ai_target_ref": { "type": "string", "pattern": "^ai:[a-z0-9][a-z0-9._/-]{2,127}$" },
        "authz_profile": { "type": "string", "minLength": 3, "maxLength": 100 },
        "approval_ref": { "type": "string", "minLength": 4, "maxLength": 128 },
        "expected_generation": { "type": "integer", "minimum": 0 },
        "policy_bundle_ref": { "type": "string", "pattern": "^policy:[a-z0-9][a-z0-9._/-]{2,127}$" }
      }
    },
    "provider": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "kind", "api_key_file", "base_url"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,63}$" },
        "kind": { "type": "string", "minLength": 1 },
        "api_key_file": { "type": "string", "minLength": 1 },
        "base_url": { "type": "string", "format": "uri" }
      }
    },
    "model": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name"],
      "properties": {
        "name": { "type": "string", "minLength": 1, "maxLength": 128 }
      }
    },
    "host": {
      "type": "string",
      "pattern": "^(?:(?:[a-z0-9-]+\\.)+[a-z]{2,}|127\\.0\\.0\\.1)$"
    },
    "mcp": {
      "type": "object",
      "additionalProperties": false,
      "required": ["target"],
      "properties": {
        "target": { "$ref": "#/$defs/mcpTarget" }
      }
    },
    "mcpTarget": {
      "type": "object",
      "additionalProperties": false,
      "required": ["name", "host", "port", "path"],
      "properties": {
        "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]{1,31}$" },
        "host": { "$ref": "#/$defs/host" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "path": { "type": "string", "pattern": "^(/[A-Za-z0-9_~-][A-Za-z0-9._~-]*)+$" },
        "tls_hostname": { "type": "string", "pattern": "^(?:[a-z0-9-]+\\.)+[a-z]{2,}$" }
      }
    },
    "a2a": {
      "type": "object",
      "additionalProperties": false,
      "required": ["agent"],
      "properties": {
        "agent": { "$ref": "#/$defs/a2aAgent" }
      }
    },
    "a2aAgent": {
      "type": "object",
      "additionalProperties": false,
      "required": ["host", "port", "path_prefix", "route_timeout"],
      "properties": {
        "host": { "$ref": "#/$defs/host" },
        "port": { "type": "integer", "minimum": 1, "maximum": 65535 },
        "tls_hostname": { "type": "string", "pattern": "^(?:[a-z0-9-]+\\.)+[a-z]{2,}$" },
        "path_prefix": { "type": "string", "pattern": "^/$|^(/[A-Za-z0-9_~-][A-Za-z0-9._~-]*)+$" },
        "route_timeout": { "type": "string", "pattern": "^[1-9][0-9]*s$" }
      }
    }
  }
}
