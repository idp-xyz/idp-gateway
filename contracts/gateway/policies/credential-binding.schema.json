{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Gatekeeper credential usage binding intent; never secret material",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "binding_id",
    "provider_id",
    "environment",
    "auth_scheme",
    "account_resolution",
    "gateway_workload_id",
    "authorized_credential_ref",
    "approval_ref"
  ],
  "properties": {
    "binding_id": {
      "type": "string",
      "minLength": 6
    },
    "provider_id": {
      "type": "string",
      "minLength": 3
    },
    "environment": {
      "enum": [
        "DEV",
        "TEST",
        "PROD"
      ]
    },
    "auth_scheme": {
      "enum": [
        "API_KEY",
        "OAUTH2_CLIENT_CREDENTIALS",
        "OAUTH2_AUTHORIZATION_CODE",
        "HMAC_REQUEST_SIGNING",
        "MTLS_CLIENT_CERT"
      ]
    },
    "account_resolution": {
      "const": "GATEKEEPER_AUTHORIZED_ACCOUNT"
    },
    "gateway_workload_id": {
      "type": "string",
      "minLength": 3
    },
    "authorized_credential_ref": {
      "type": "string",
      "pattern": "^gatekeeper:[a-z0-9/_-]+$"
    },
    "scope_set": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "audience": {
      "type": "string"
    },
    "token_ttl_max_seconds": {
      "type": "integer",
      "minimum": 1,
      "maximum": 3600
    },
    "request_signer_ref": {
      "type": "string",
      "pattern": "^signer:[a-z0-9/_-]+$"
    },
    "approval_ref": {
      "type": "string",
      "minLength": 4
    }
  }
}
