{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "IDP Traffic Control Intent V1.0",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "policy_id",
    "traffic_class",
    "environment",
    "quota_buckets",
    "failure_policy",
    "timeout_budget_ms",
    "retry_mode",
    "approval_ref"
  ],
  "properties": {
    "policy_id": {
      "type": "string",
      "pattern": "^policy:[a-z0-9][a-z0-9._/-]{2,127}$"
    },
    "traffic_class": {
      "enum": [
        "INGRESS",
        "EGRESS",
        "AI"
      ]
    },
    "environment": {
      "enum": [
        "DEV",
        "TEST",
        "PROD"
      ]
    },
    "quota_buckets": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "key_dimensions",
          "max_requests",
          "window_seconds",
          "coordination"
        ],
        "properties": {
          "key_dimensions": {
            "type": "array",
            "minItems": 1,
            "uniqueItems": true,
            "items": {
              "enum": [
                "pool",
                "provider",
                "provider_account",
                "tenant",
                "service",
                "operation"
              ]
            }
          },
          "max_requests": {
            "type": "integer",
            "minimum": 1
          },
          "window_seconds": {
            "type": "integer",
            "minimum": 1,
            "maximum": 86400
          },
          "coordination": {
            "enum": [
              "LOCAL_APPROXIMATE",
              "DISTRIBUTED_COORDINATED"
            ]
          },
          "coordinator_failure": {
            "enum": [
              "REJECT",
              "STRICT_LOCAL_CAP"
            ]
          },
          "strict_local_cap": {
            "type": "integer",
            "minimum": 1
          }
        },
        "allOf": [
          {
            "if": {
              "properties": {
                "coordination": {
                  "const": "DISTRIBUTED_COORDINATED"
                }
              }
            },
            "then": {
              "required": [
                "coordinator_failure"
              ]
            }
          },
          {
            "if": {
              "properties": {
                "coordinator_failure": {
                  "const": "STRICT_LOCAL_CAP"
                }
              },
              "required": [
                "coordinator_failure"
              ]
            },
            "then": {
              "required": [
                "strict_local_cap"
              ]
            }
          }
        ]
      }
    },
    "failure_policy": {
      "enum": [
        "FAIL_CLOSED",
        "BOUNDED_POLICY_CACHE"
      ]
    },
    "timeout_budget_ms": {
      "type": "integer",
      "minimum": 10,
      "maximum": 300000
    },
    "max_in_flight": {
      "type": "integer",
      "minimum": 1
    },
    "max_connections_per_upstream": {
      "type": "integer",
      "minimum": 1
    },
    "retry_mode": {
      "const": "IDEMPOTENT_ONLY_EXPLICIT"
    },
    "upstream_health": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "mode",
        "failure_threshold",
        "open_seconds"
      ],
      "properties": {
        "mode": {
          "enum": [
            "ACTIVE",
            "PASSIVE",
            "COMBINED"
          ]
        },
        "failure_threshold": {
          "type": "integer",
          "minimum": 1
        },
        "open_seconds": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "approval_ref": {
      "type": "string",
      "minLength": 4
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "traffic_class": {
            "const": "EGRESS"
          }
        }
      },
      "then": {
        "properties": {
          "quota_buckets": {
            "contains": {
              "properties": {
                "key_dimensions": {
                  "contains": {
                    "const": "provider_account"
                  }
                }
              }
            }
          }
        }
      }
    }
  ]
}
