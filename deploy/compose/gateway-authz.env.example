# The variables of gateway-authz.yml. Put them in the same .env as the pool's (copy these lines in and fill them);
# they are kept apart from .env.example because compose.yml alone does not read them. Same rules for each line:
# NAME=value, no quotes, no comment after the value, no white space, $, # or backslash in the value. Missing ones:
# docker compose names the first it finds.

# The gateway-authz binary of the host, absolute path, static:
#   CGO_ENABLED=0 go build -trimpath -o gateway-authz ./cmd/gateway-authz
GATEWAY_AUTHZ=
# uid:gid it runs as. It must read every file below.
GATEWAY_AUTHZ_USER=

# The register (the operations, which tenants and clients may use which accounts): JSON, absolute path.
# deploy/providers/wanbexpress/policy.example.json is an example.
GATEWAY_AUTHZ_POLICY=
# The DIRECTORY that holds developer-tokens.json: {"<binding>/<account>": {"account": "...", "token": "..."}}, mode 0600,
# outside the repository. gateway-authz reads it again when the file is replaced by a rename.
GATEWAY_AUTHZ_CREDENTIALS_DIR=

# The mutual TLS of the hop gateway -> gateway-authz. Server certificate and key of gateway-authz (the name the gateway
# checks is written in the published configuration, backendTLS.hostname); the CA that issued the gateway's own certificate
# (tls/gateway.crt in the pool's tls directory); the identity in that certificate (its URI subjectAltName).
GATEWAY_AUTHZ_TLS_CERT=
GATEWAY_AUTHZ_TLS_KEY=
GATEWAY_AUTHZ_GATEWAY_CA=
GATEWAY_AUTHZ_GATEWAY_IDENTITY=

# The PDP (Gatekeeper). Not loopback, so all of these are required. URL (https) and the name its certificate must carry;
# the Bearer token file (0600) it still takes during the transition; the client certificate and key gateway-authz presents,
# and the CA that issued the PDP's certificate.
GATEWAY_AUTHZ_PDP_URL=
GATEWAY_AUTHZ_PDP_NAME=
GATEWAY_AUTHZ_PDP_TOKEN_FILE=
GATEWAY_AUTHZ_PDP_CERT=
GATEWAY_AUTHZ_PDP_KEY=
GATEWAY_AUTHZ_PDP_CA=
