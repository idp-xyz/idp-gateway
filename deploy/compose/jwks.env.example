# The variables of jwks.yml. Put them in the same .env as the pool's (copy these lines in and fill them);
# they are kept apart from .env.example because compose.yml alone does not read them. Same rules for each line:
# NAME=value, no quotes, no comment after the value, no white space, $, # or backslash in the value. Missing ones:
# docker compose names the first it finds.

# Required when this overlay is used. https, or an http URL the command already allows: a loopback literal
# (localhost does not count; it has to be resolved), or one bare host if you add --plain-http-host to the
# command yourself. This example has no host, token, or key.
JWKS_URL=

# These three may be omitted. The overlay then uses the command's own defaults.
# JWKS_INTERVAL=15s
# JWKS_TIMEOUT=3s
# JWKS_MAX_STALE=15m

# --empty-on-stale is off. A failed fetch keeps the previous file until max-stale and does not wipe the keys.
