# The variables of coordinators.yml. Put them in the same .env as the pool's, gateway-authz's and provider-signer's (copy these
# lines in and fill them); they are kept apart from .env.example because compose.yml alone does not read them. Same rules for
# each line: NAME=value, no quotes, no comment after the value, no white space, $, # or backslash in the value. Missing ones:
# docker compose names the first it finds. Every one is required.

# The two binaries of the host, absolute paths, static:
#   CGO_ENABLED=0 go build -trimpath -o sf-token-coordinator ./cmd/sf-token-coordinator
#   CGO_ENABLED=0 go build -trimpath -o authz-state ./cmd/authz-state
SF_TOKEN_COORDINATOR=
AUTHZ_STATE=
# uid:gid each runs as. Not root. Each must read its certificate files and own its state directory below.
SF_TOKEN_COORDINATOR_USER=
AUTHZ_STATE_USER=

# Server certificate and key of each coordinator, and the DNS name in it (gateway-authz checks the certificate for that name,
# --sf-openapi-lease-name and --authz-state-name; the URL it dials is the service name, sf-token-coordinator or authz-state).
SF_TOKEN_COORDINATOR_TLS_CERT=
SF_TOKEN_COORDINATOR_TLS_KEY=
SF_TOKEN_COORDINATOR_NAME=
AUTHZ_STATE_TLS_CERT=
AUTHZ_STATE_TLS_KEY=
AUTHZ_STATE_NAME=
# The CA that issued the two certificates above. gateway-authz trusts only this CA for these two hops, not the system roots.
COORDINATORS_CA=

# The caller. gateway-authz presents GATEWAY_AUTHZ_PDP_CERT and GATEWAY_AUTHZ_PDP_KEY (gateway-authz.env.example) to both
# coordinators as well; that certificate needs the clientAuth usage and a URI subjectAltName. The CA that issued it, and that
# URI: the only identity the coordinators serve. Every replica of gateway-authz presents the same one.
COORDINATORS_CLIENT_CA=
COORDINATORS_AUTHZ_IDENTITY=

# One directory per coordinator, absolute path, outside the repository, owned by that coordinator's user, mode 0700, made
# before the first up. sf-token-coordinator writes leases.json in the first (it holds access tokens); authz-state writes
# state.json in the second (revocations and bans; the quota buckets are not in it). Each file is created 0600 when missing.
SF_TOKEN_COORDINATOR_STATE_DIR=
AUTHZ_STATE_STATE_DIR=

# gateway-authz's additions. The identity in the certificate gateway-control presents to revoke, restore and list (its URI
# subjectAltName); it must differ from GATEWAY_AUTHZ_GATEWAY_IDENTITY. The quota file (JSON: version and buckets), absolute
# path, read by gateway-authz's user; no secret in it. It is required: {"version": "none", "buckets": []} is no quota.
GATEWAY_AUTHZ_REVOKER_IDENTITY=
GATEWAY_AUTHZ_RATE_LIMITS=
