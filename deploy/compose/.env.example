# 一个池的设置。复制成同目录下的 .env 再填；没有填的，docker compose 会报出是哪一个。
# 这个文件里没有密钥：会话密钥在 GATEWAY_ENV_FILE 指的那个文件里。

# 业务请求从本机的哪个地址、哪个端口进来，写成 地址:端口，例如 10.0.0.5:8080。
# 写 0.0.0.0 是对所有网卡开放。docker 映射出来的端口不经过本机防火墙的 INPUT 规则。
CALLERS_LISTEN=

# 回读口映射到本机回环的哪个端口。在本机上跑 gateway-control 时，--read-back 给的就是 127.0.0.1:这个端口。
READBACK_PORT=
# 回读口证书上的名字（gateway-control 的 --read-back-name）。
READBACK_NAME=

# 池的目录，绝对路径。下面要有两个子目录：
#   config/   网关读的配置文件 config.yaml 在这里，由发布器写。属主是 CONTROL_USER，权限 0755
#   tls/      网关用的证书和私钥，快照里按 tls/<文件名> 引用。GATEWAY_USER 要读得到
POOL_DIR=

# 网关进程以哪个 uid:gid 运行。
GATEWAY_USER=
# 在本机上跑 gateway-control 的那个账号的 uid:gid（id -u 和 id -g 的输出）。
# place 和 confirm 两步以它的身份运行：它们写的文件、读的记录要和本机上发布时是同一个属主。
CONTROL_USER=

# 给网关进程的环境变量文件，绝对路径，权限 0600。只有一行：SESSION_KEY=<64 个十六进制字符>
GATEWAY_ENV_FILE=

# 发布器的二进制，绝对路径。必须是静态链接的：
#   CGO_ENABLED=0 go build -trimpath -o gateway-control ./cmd/gateway-control
GATEWAY_CONTROL=

# 发布器读回读口用的证书、私钥，和签发回读口证书的 CA，都是绝对路径。
# 与在本机上跑 gateway-control 时的 --tls-cert、--tls-key、--tls-ca 是同一套；CONTROL_USER 要读得到。
PUBLISHER_CERT=
PUBLISHER_KEY=
READBACK_CA=

# 以下可以不设。
#
# 启动时 confirm 最多等网关多久。到时还读不到网关，front 不启动。
# CONFIRM_TIMEOUT=60s
#
# 两个镜像默认按摘要引用测过的那两个。镜像经内部仓库转存时改仓库名，摘要不要改。
# GATEWAY_IMAGE=cr.agentgateway.dev/agentgateway@sha256:60216aafb03d37f94e952ff3d51d2f630a65b10ecaebdc0a864882f92610c45b
# FRONT_IMAGE=public.ecr.aws/nginx/nginx-unprivileged:stable-alpine@sha256:c3fc8fa482be50ef709c6438eb1bc98d50dbfe5a9b48be90711b8814f4dfd701
