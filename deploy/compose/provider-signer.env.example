# The variables of provider-signer.yml. Put them in the same .env as the pool's and gateway-authz's
# (copy these lines in and fill them); they are kept apart from .env.example because compose.yml alone
# does not read them. Same rules for each line: NAME=value, no quotes, no comment after the value, no
# white space, $, # or backslash in the value. Missing required ones: docker compose names the first it finds.
# SIGNER_PLAIN_HTTP_HOST and GATEWAY_AUTHZ_SF_PLAIN_HTTP_HOST may be empty: an empty value is no
# plain-HTTP exception. They are not required.

# The provider-signer binary of the host, absolute path, static:
#   CGO_ENABLED=0 go build -trimpath -o provider-signer ./cmd/provider-signer
SIGNER=
# uid:gid it runs as. It must read the certificate files below. Not root.
SIGNER_USER=

# The mutual TLS of the hop gateway -> signer. Server certificate and key (the name the gateway checks is
# provider-signer.idp.test, backendTLS.hostname in the published configuration); the CA that issued the
# gateway's own certificate (tls/gateway.crt in the pool's tls directory).
SIGNER_TLS_CERT=
SIGNER_TLS_KEY=
SIGNER_CLIENT_CA=
# The identity in the gateway's certificate (its URI subjectAltName). The signer serves only that caller.
SIGNER_GATEWAY_IDENTITY=

# The carrier's dispatch URL, the whole thing (https, or http for a loopback literal or for the host below).
SIGNER_CARRIER_URL=
# Bare host name. Empty: the signer allows plain HTTP only for a loopback literal.
SIGNER_PLAIN_HTTP_HOST=

# The small file signer-egress reads (absolute path, outside the repository). Block style, one carrier:
#   host: name:port
# pin-egress.sh resolves that name when `once` runs. A name that does not resolve then is not pinned.
SIGNER_EGRESS_CONFIG=

# Bare host name passed to gateway-authz as --sf-openapi-plain-http-host. Empty: no plain-HTTP exception.
# The apps file is not a variable: it is /authz/credentials/sfintl.apps.json inside GATEWAY_AUTHZ_CREDENTIALS_DIR
# (the directory gateway-authz.yml already mounts). That directory must also still hold developer-tokens.json,
# because this overlay keeps gateway-authz.yml's command and only adds arguments; {} is a valid file when this
# carrier is the only one. Both files mode 0600. gateway-authz re-reads the apps file when it is replaced by a rename.
GATEWAY_AUTHZ_SF_PLAIN_HTTP_HOST=
